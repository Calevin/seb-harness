#!/usr/bin/env bash
# .agents/hooks/git-post-commit (Se enlaza en .git/hooks/post-commit)
# Registra el commit en el Audit Trail de SQLite vinculado a la spec activa

set -uo pipefail

SEB_BIN=".seb/bin/seb"
[ ! -x "${SEB_BIN}" ] && exit 0

COMMIT_HASH="$(git rev-parse --short HEAD 2>/dev/null || echo 'unknown')"
COMMIT_MSG="$(git log -1 --pretty=%s 2>/dev/null | cut -c 1-120 || echo '')"

# Delegamos la resolucion de tarea activa a la cascada de seb audit log
"${SEB_BIN}" audit log \
  -agent="git-hook" \
  -skill="git" \
  -action="git-commit" \
  -params="${COMMIT_HASH}" \
  -result="${COMMIT_MSG}" \
  -exit-code=0 >/dev/null 2>&1 || true

exit 0
